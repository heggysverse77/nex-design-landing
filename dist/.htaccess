<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct execution of API and existing static files
  RewriteCond %{REQUEST_URI} ^/api/ [NC,OR]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite SPA routes to index.html
  RewriteRule ^ /index.html [L]
</IfModule>

# Block direct access to .env and git files
<FilesMatch "^\.(env|git|htaccess)">
  Order allow,deny
  Deny from all
</FilesMatch>

# Prevent browser caching of index.html so users always get the latest live build
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
