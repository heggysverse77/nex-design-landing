# ===================================================
# NEX DESIGN STUDIO - ENVIRONMENT TEMPLATE
# ===================================================

# MySQL Database
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# SMTP Email Provider
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password
MAIL_FROM_EMAIL=your_email@domain.com
MAIL_FROM_NAME="Nex Design Studio"

# Admin & Security
ADMIN_EMAIL=admin@domain.com
ADMIN_PASSWORD=your_admin_password
JWT_SECRET=your_secret_jwt_key
ACCOUNT_ALLOWED_ORIGINS=https://nex-design.online,http://tauri.localhost,tauri://localhost
OFFLINE_LEASE_PRIVATE_KEY_PATH=/absolute/server/path/offline-lease-private.pem
